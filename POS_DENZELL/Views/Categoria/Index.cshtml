@model IEnumerable<POS_DENZELL.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-10">

        <!-- Alertas de Éxito o Error (Desaparecen solas al cambiar de página) -->
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0" style="border-radius: 12px;">

            <!-- Cabecera de la Tarjeta -->
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center" style="border-radius: 12px 12px 0 0;">
                <h4 class="mb-0 fw-bold text-secondary"><i class="bi bi-tags"></i> Lista de Categorías</h4>
                <a asp-action="Crear" class="btn btn-primary fw-bold shadow-sm">
                    <i class="bi bi-plus-lg"></i> Nueva Categoría
                </a>
            </div>

            <!-- Cuerpo con la Tabla -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Nombre de la Categoría</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No hay categorías registradas. ¡Crea la primera!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-muted">@item.IdCategoria</td>
                                        <td class="fw-bold">@item.Nombre</td>
                                        <td class="text-center">
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success px-3 py-2 rounded-pill">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger px-3 py-2 rounded-pill">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-center pe-4">
                                            <!-- Botón Editar -->
                                            <a asp-action="Editar" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-outline-warning fw-bold me-1">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>

                                            <!-- Botón Activar/Desactivar (Mini formulario por seguridad) -->
                                            <form asp-action="CambiarEstado" asp-route-id="@item.IdCategoria" method="post" class="d-inline">
                                                @if (item.Activo)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('¿Seguro que deseas desactivar esta categoría? Los productos que la usan no se borrarán, pero no podrán seleccionarla en el futuro.');">
                                                        <i class="bi bi-power"></i> Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success fw-bold">
                                                        <i class="bi bi-check-circle"></i> Activar
                                                    </button>
                                                }
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>