@model POS_DENZELL.Models.Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0" style="border-radius: 12px;">
            
            <div class="card-header bg-primary text-white py-3" style="border-radius: 12px 12px 0 0;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-tag-fill me-2"></i> Crear Nueva Categoría</h5>
            </div>

            <div class="card-body p-4">
                
                <!-- Salto de error -->
                <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

                <form asp-action="Crear" method="post">
                    
                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label fw-bold text-secondary">Nombre de la Categoría</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-type"></i></span>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej: Bebidas, Chocolates..." required autocomplete="off" autofocus>
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Guardar Categoría</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}