@model POS_DENZELL.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0" style="border-radius: 12px;">
            
            <div class="card-header bg-warning text-dark py-3" style="border-radius: 12px 12px 0 0;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Editar Categoría</h5>
            </div>

            <div class="card-body p-4">
                
                <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

                <form asp-action="Editar" method="post">
                    
                    <!-- CRÍTICO: El ID oculto para que Entity Framework sepa qué fila actualizar -->
                    <input type="hidden" asp-for="IdCategoria" />
                    <!-- También mandamos el estado oculto para que no se altere por accidente -->
                    <input type="hidden" asp-for="Activo" />

                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label fw-bold text-secondary">Nombre de la Categoría</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-type"></i></span>
                            <input asp-for="Nombre" class="form-control form-control-lg" required autocomplete="off" autofocus>
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4 shadow-sm">Actualizar Cambios</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}