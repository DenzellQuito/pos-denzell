@using POS_DENZELL.Models
@{
    ViewData["Title"] = "Panel de Control";
    var stockCritico = ViewBag.StockCritico as List<Producto> ?? new List<Producto>();
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success mb-0"><i class="bi bi-speedometer2"></i> Panel Operativo</h2>
            <small class="text-muted">Control en vivo del turno actual e inventario crítico</small>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a href="/Reporte/Index" class="btn btn-dark fw-bold shadow-sm">
                <i class="bi bi-bar-chart-line-fill text-warning me-1"></i> Ir a Reportes BI
            </a>
        }
    </div>

    <!-- LÓGICA DE INTERFAZ: CAJA CERRADA -->
    @if (ViewBag.CajaAbierta == false)
    {
        <div class="row justify-content-center my-4">
            <div class="col-md-6 text-center">
                <div class="card shadow-sm border-0" style="border-radius: 14px;">
                    <div class="card-body py-5">
                        <h1 class="display-2 text-warning mb-3">🔒</h1>
                        <h3 class="fw-bold">La Caja está Cerrada</h3>
                        <p class="text-muted mb-4">Para registrar ventas debes realizar la apertura de caja e ingresar el sencillo inicial.</p>

                        <a href="/Caja/Apertura" class="btn btn-warning btn-lg px-5 fw-bold text-dark shadow-sm">
                            <i class="bi bi-key-fill"></i> Aperturar Caja Ahora
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- LÓGICA DE INTERFAZ: CAJA ABIERTA -->
        <div class="alert alert-success shadow-sm border-0 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <div>
                <h5 class="mb-0 fw-bold">🟢 Caja Operativa (Turno #@ViewBag.IdTurno.ToString("D4"))</h5>
                <small>Abierta por <b>@ViewBag.NombreCajero</b> a las @ViewBag.HoraApertura — <b>@ViewBag.CantidadTickets ticket(s)</b> emitidos hoy</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/Caja/DetalleTurno/@ViewBag.IdTurno" class="btn btn-outline-dark fw-bold shadow-sm">
                    <i class="bi bi-receipt"></i> Ver Tickets / Yapes
                </a>
                <a href="/Caja/PuntoDeVenta" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-cart-check-fill"></i> Ir al Punto de Venta
                </a>
            </div>
        </div>

        <!-- MICRO-BI DEL TURNO ACTUAL -->
        <div class="row g-3 mb-4">
            <!-- Tarjeta 1: Efectivo físico esperado en cajón -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body">
                        <small class="text-muted text-uppercase fw-bold">Efectivo en Gaveta</small>
                        <h3 class="fw-bold text-dark mt-1 mb-1">S/ @ViewBag.EfectivoEnGaveta.ToString("0.00")</h3>
                        <small class="text-muted d-block">
                            Inicial: S/ @ViewBag.MontoInicial.ToString("0.00") | Gastos: <span class="text-danger">-S/ @ViewBag.Gastos.ToString("0.00")</span>
                        </small>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Total Ventas del Turno -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 bg-success text-white" style="border-radius: 12px;">
                    <div class="card-body">
                        <small class="text-white-50 text-uppercase fw-bold">Total Vendido (Turno)</small>
                        <h3 class="fw-bold mt-1 mb-1">S/ @ViewBag.TotalVentas.ToString("0.00")</h3>
                        <small class="text-white-50 d-block">
                            <i class="bi bi-receipt"></i> @ViewBag.CantidadTickets ventas cobradas
                        </small>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Desglose Efectivo vs Yape -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body">
                        <small class="text-muted text-uppercase fw-bold">Desglose de Cobros</small>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-secondary small"><i class="bi bi-cash-coin text-success"></i> Efectivo Neto:</span>
                            <span class="fw-bold text-success">S/ @ViewBag.IngresosEfectivo.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="text-secondary small"><i class="bi bi-phone-fill text-primary"></i> Pagos Yape:</span>
                            <span class="fw-bold text-primary">S/ @ViewBag.IngresosYape.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 4: Acciones Rápidas de Caja -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body d-flex flex-column justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalGastoCaja">
                            <i class="bi bi-box-arrow-right"></i> Registrar Gasto Extra
                        </button>
                        <a href="/Caja/Cierre" class="btn btn-danger btn-sm fw-bold shadow-sm">
                            <i class="bi bi-lock-fill"></i> Cuadrar y Cerrar Caja
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ALERTA DE STOCK CRÍTICO (Visible para Cajero y Admin) -->
    <div class="card shadow-sm border-0 mt-2" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center" style="border-radius: 12px 12px 0 0;">
            <h6 class="mb-0 fw-bold text-danger">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Alerta de Stock Bajo (Productos por agotarse)
            </h6>
            @if (User.IsInRole("Administrador"))
            {
                <a href="/Producto/Index" class="btn btn-sm btn-outline-primary fw-bold">Ir a Inventario</a>
            }
        </div>
        <div class="card-body p-0">
            @if (!stockCritico.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check-circle-fill text-success fs-4 d-block mb-1"></i>
                    Todos los productos activos tienen buen nivel de stock (mayor a 5 unidades).
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">CÓDIGO</th>
                                <th>PRODUCTO</th>
                                <th>CATEGORÍA</th>
                                <th class="text-end">PRECIO</th>
                                <th class="text-center pe-4">STOCK ACTUAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in stockCritico)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-secondary">@item.CodigoBarras</span></td>
                                    <td class="fw-bold text-dark">
                                        @item.Descripcion
                                        @if (item.EsFiesta)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">🎉 Fiesta</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@(item.Categoria?.Nombre ?? "Sin Categoría")</td>
                                    <td class="text-end fw-bold text-success">S/ @item.Precio.ToString("0.00")</td>
                                    <td class="text-center pe-4">
                                        @if (item.Stock <= 0)
                                        {
                                            <span class="badge bg-danger px-3 py-1">AGOTADO (@item.Stock)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-1">Quedan @item.Stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL PARA REGISTRAR GASTO EXTRA DE CAJA -->
<div class="modal fade" id="modalGastoCaja" tabindex="-1" aria-labelledby="modalGastoCajaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalGastoCajaLabel"><i class="bi bi-box-arrow-right"></i> Registrar Salida de Dinero</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Caja" asp-action="RegistrarGasto" method="post">
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">Usa esta opción para registrar dinero que retiras de la gaveta para pagos rápidos (ej. pasajes, bolsas, pago a proveedores menores).</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Monto a retirar (S/)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold text-danger">S/</span>
                            <input type="number" name="Monto" class="form-control" step="0.01" min="0.10" placeholder="0.00" required autofocus>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Motivo / Descripción</label>
                        <input type="text" name="Descripcion" class="form-control" placeholder="Ej: Pasaje, bolsas plásticas..." required maxlength="100">
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold px-4">Guardar Salida</button>
                </div>
            </form>
        </div>
    </div>
</div>