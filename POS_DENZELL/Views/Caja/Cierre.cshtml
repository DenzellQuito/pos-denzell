@model POS_DENZELL.DTOs.ResumenCajaDTO
@{
    ViewData["Title"] = "Cierre de Caja";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0" style="border-radius: 12px;">
            <div class="card-header bg-dark text-white text-center" style="border-radius: 12px 12px 0 0;">
                <h5 class="mb-0 py-2 fw-bold"><i class="bi bi-lock-fill"></i> Arqueo y Cierre de Caja</h5>
            </div>

            <div class="card-body p-4 bg-light">

                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.8rem;">Detalle General del Turno</h6>

                <div class="bg-white p-3 rounded border mb-4 shadow-sm">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Monto Inicial (Sencillo):</span>
                        <span class="fw-bold">S/ @Model.MontoInicial.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Ventas en Efectivo:</span>
                        <span class="fw-bold text-success">+ S/ @Model.IngresosEfectivo.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-secondary">Salidas / Gastos Extra:</span>
                        <span class="fw-bold text-danger">- S/ @Model.Gastos.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5 text-dark">Efectivo en Gaveta:</span>
                        <span class="fw-bold fs-4 text-primary">S/ @Model.EfectivoEsperadoFisico.ToString("0.00")</span>
                    </div>

                    <div class="mt-3 pt-3 border-top d-flex justify-content-between">
                        <span class="text-muted small"><i class="bi bi-bank"></i> Total en Yape (App):</span>
                        <span class="fw-bold text-muted small">S/ @Model.IngresosYape.ToString("0.00")</span>
                    </div>
                </div>

                <hr />

                <!-- Formulario de Declaración Real -->
                <form asp-controller="Caja" asp-action="ProcesarCierre" method="post">
                    <input type="hidden" name="IdTurno" value="@Model.IdTurno" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">¿Cuánto dinero físico hay en la gaveta?</label>
                        <p class="text-muted small mb-2">Cuenta los billetes y monedas, e ingresa el monto total exacto.</p>

                        <div class="input-group input-group-lg border-dark border-1">
                            <span class="input-group-text bg-white fw-bold">S/</span>
                            <input type="number" step="0.01" min="0" name="MontoFinalReal" class="form-control fw-bold fs-4" required placeholder="0.00" autocomplete="off" autofocus />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm" onclick="return confirm('¿Estás completamente seguro de cerrar la caja? Esta acción no se puede deshacer.')">
                            Confirmar y Cerrar Caja
                        </button>
                        <a href="/Home/Index" class="btn btn-outline-secondary">Cancelar y volver al Panel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>