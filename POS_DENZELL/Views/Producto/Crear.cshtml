@model POS_DENZELL.Models.Producto
@{
    ViewData["Title"] = "Registrar Producto";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card shadow border-0" style="border-radius: 12px;">
            <div class="card-header bg-primary text-white" style="border-radius: 12px 12px 0 0;">
                <h5 class="mb-0 py-2 fw-bold"><i class="bi bi-box-seam"></i> Registrar Nuevo Dulce</h5>
            </div>

            <div class="card-body p-4">
                <div class="card-body p-4">
                
                <!-- ESTO MOSTRARÁ LOS ERRORES DEL SERVIDOR (Como el de la imagen) -->
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

              
                <!-- multipart/form-data es obligatorio para IFormFile -->
                <form asp-action="Crear" method="post" enctype="multipart/form-data">

                    <div class="row g-3">
                        <!-- Columna Izquierda: Datos de texto -->
                        <div class="col-md-8">

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Código de Barras</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                    <input type="text" asp-for="CodigoBarras" class="form-control" placeholder="Ej: 7751234..." required autofocus>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Descripción (Nombre del Producto)</label>
                                <input type="text" asp-for="Descripcion" class="form-control" placeholder="Ej: Chocolate Sublime 30g" required>
                            </div>

                            <div class="row">
                                <div class="col-12 col-sm-6 mb-3">
                                        <label class="form-label fw-bold text-secondary">Categoría</label>
                                        <select asp-for="IdCategoria" class="form-select" required>
                                            <option value="">-- Seleccionar --</option>
                                            @foreach (var cat in ViewBag.Categorias)
                                            {
                                                <option value="@cat.IdCategoria">@cat.Nombre</option>
                                            }
                                        </select>
                                </div>

                                <div class="col-12 mb-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="EsFiesta" id="chkEsFiesta" role="switch">
                                            <label class="form-check-label" for="chkEsFiesta">
                                                Mostrar también en la categoría "Fiesta"
                                            </label>
                                        </div>
                                </div>

                                <div class="col-6 col-sm-4 mb-3">
                                        <label class="form-label fw-bold text-secondary text-nowrap">Precio (S/)</label>
                                        <input type="number" asp-for="Precio" step="0.001" min="0" class="form-control" placeholder="0.000" required>
                                </div>

                                <div class="col-6 col-sm-4 mb-3">
                                        <label class="form-label fw-bold text-secondary text-nowrap">Stock Inicial</label>
                                        <input type="number" asp-for="Stock" min="0" class="form-control" value="0" required>
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha: Fotografía con vista previa -->
                        <div class="col-md-4 d-flex flex-column align-items-center justify-content-center border-start">
                            <label class="form-label fw-bold text-secondary w-100 text-center">Fotografía</label>

                            <!-- Caja de vista previa de imagen -->
                            <div class="mb-3 border rounded shadow-sm d-flex align-items-center justify-content-center bg-light" style="width: 150px; height: 150px; overflow: hidden;">
                                <img id="imgPreview" src="/images/default-product.png" alt="Vista previa" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>

                            <input type="file" name="Foto" id="inputFoto" class="form-control form-control-sm" accept="image/*" onchange="previewImage(event)">
                            <small class="text-muted mt-2 text-center" style="font-size: 0.75rem;">Formatos: JPG, PNG</small>
                        </div>
                    </div>

                    <hr class="mt-4 mb-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Producto/Index" class="btn btn-outline-secondary fw-bold">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-bold shadow-sm px-4">Guardar Producto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Mini script para que la foto se muestre apenas el usuario la selecciona de sus archivos -->
    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imgPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = "/images/default-product.png";
            }
        }
    </script>
}