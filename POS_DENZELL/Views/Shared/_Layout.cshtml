@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();

    string Activo(string c, string? a = null) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(accion, a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS DENZELL</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/POS_DENZELL.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-xl">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-shop"></i></span>
                    Golosinas Javier &amp; Jose
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                        aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto gap-lg-1 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Producto")" asp-controller="Producto" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Inventario
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Categoria")" asp-controller="Categoria" asp-action="Index">
                                    <i class="bi bi-tags"></i> Categorías
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Caja", "Historial")" asp-controller="Caja" asp-action="Historial">
                                    <i class="bi bi-clock-history"></i> Auditoría
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Reporte")" asp-controller="Reporte" asp-action="Index">
                                    <i class="bi bi-bar-chart-line"></i> Reportes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Activo("Usuario")" asp-controller="Usuario" asp-action="Index">
                                    <i class="bi bi-people"></i> Usuarios
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        <!-- boton punto de venta -->
                        <a class="btn btn-brand btn-sm" asp-controller="Caja" asp-action="PuntoDeVenta">
                            <i class="bi bi-cart-check"></i> Vender
                        </a>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <a class="user-menu dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">@User.Identity.Name!.Substring(0, 1).ToUpper()</span>
                                    <span class="d-none d-xl-inline">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            @(User.IsInRole("Administrador") ? "Administrador" : "Cajero")
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-xl">POS DENZELL · @DateTime.Now.Year</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>